# PostgreSQL settings for the Warehouse API, Drizzle migrations and workers.
# Workers run as separate processes from this same backend repository.

DATABASE_URL=postgresql://sargis:1111@localhost:5442/warehouse?schema=public
JWT_SIGNATURE=secret123456789
FRONTEND_URL=http://localhost:3000
PORT=3300

# The HTTP API does not need repository paths. Worker settings are in .env.worker.example.
# Legacy API UI indicator: keep key presence consistent with the worker when enabling AI.
GEMINI_API_KEY=

# Shared authentication: assistant and warehouse app clients belong to this pool.
COGNITO_USER_POOL_ID=us-east-1_QsJSsFk4H
# Used for exact-plan email links and allowed browser origin.
ASSISTANT_APP_URL=http://localhost:3006
