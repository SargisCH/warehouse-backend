# Install as /srv/warehouse-api/shared/.env, readable only by the deployment user.
# Use literal values, without shell expansion or `export`.
NODE_ENV=production
PORT=3300
DATABASE_URL=postgresql://warehouse:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/warehouse
JWT_SIGNATURE=REPLACE_WITH_RANDOM_SECRET
FRONTEND_URL=https://app.example.com
ASSISTANT_APP_URL=https://assistant.example.com
COGNITO_USER_POOL_ID=REPLACE_WITH_EXISTING_POOL_ID

# Optional API readiness indicator. Actual AI generation requires a separate worker.
GEMINI_API_KEY=

# Required only for existing AWS-backed features such as company-logo uploads.
# Use credentials restricted to the required resources. This variable name is
# intentional: the current application reads AWS_SECRET_ACCESS_KEY_ID.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY_ID=
