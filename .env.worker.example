# Run from warehouse-backend. The worker lives in this repo; no separate project is needed.
# Copy this file to .env.worker and use the SAME database as the HTTP API.
# DOTENV_CONFIG_PATH=.env.worker npm run assistant:worker
DATABASE_URL=postgresql://postgres:password@localhost:5442/warehouse?schema=public

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Repo paths are detected from the standard sibling checkout layout automatically.
# No repo-path variables are required for warehouse-backend + ../warehouse-frontend.

ASSISTANT_IMPLEMENTATION_ENABLED=false
ASSISTANT_CHECK_IMAGE=node:22-bookworm-slim
ASSISTANT_BACKEND_BASE_BRANCH=main
ASSISTANT_FRONTEND_BASE_BRANCH=main

ASSISTANT_APP_URL=http://localhost:3006
ASSISTANT_EMAIL_ENABLED=false
ASSISTANT_EMAIL_FROM=
RESEND_API_KEY=

# Absolute committed Finit monorepo checkout, used for Finit feedback plans only.
ASSISTANT_FINIT_REPO=

# Refresh origin before each feedback plan/regeneration. Defaults to each checkout's
# current branch. Optional pins must match the branch checked out on the server.
# Latest branch source may include changes not yet deployed.
ASSISTANT_BACKEND_SOURCE_BRANCH=
ASSISTANT_FRONTEND_SOURCE_BRANCH=
ASSISTANT_FINIT_SOURCE_BRANCH=main
